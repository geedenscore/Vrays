hTM   = input.color (#f6a4a6, "",  group = gT, inline = "rM", display = display.none)
lTM   = input.color (#a4f6c0, "",  group = gT, inline = "rM", display = display.none)
sTM   = input.string("Solid", "",  group = gT, inline = "rM", options = ["Solid", "Dashed", "Dotted"], tooltip = TIP, display = display.none)

sty(string s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// The shade's fill: the row's own line colour, or the custom pair, with the shade's own
// transparency stamped over whatever the source colour was carrying. color.new REPLACES
// transparency rather than compounding it, which is what makes the slider absolute --
// the same 88 reads the same whether the row's line colour was opaque or not.
shade_css(bool isb, color col) => color.new(shdSrc == "Custom" ? (isb ? shdBull : shdBear) : col, shdTrans)

// ─── State ────────────────────────────────────────────────────────────────────
// One slot = one direction on one timeframe. The level is the DISTAL edge of the
// imbalance: candle 1's high on a bullish displacement, candle 1's low on a bearish
// one. Candle 1 is the candle that JUST CLOSED -- the forming candle is the
// displacement, so the edge being left behind is the last closed candle's extreme
// tick. It arms only once price trades beyond it (the gap is being created) and dies
// the moment price is back on the wrong side of it (swept -- the level has been
// tested, so there is no imbalance left to mark). So a bear level is only ever on
// the chart while price is below it, a bull level only while price is above it.
type Lvl
    line  ln   = na
    label lb   = na
    box   sh   = na     // price-to-level shade, na when this row is not shaded
    float cand = na     // candle 1's high (bull) or low (bear) -- ONE close back
    float lvl  = na     // armed level, na = nothing live
    bool  used = false  // candidate already armed during this HTF candle
    int   b0   = na     // chart bar where the CURRENT (forming) candle opened
    int   b1   = na     // chart bar where candle 1 opened -- the level's source
    int   anch = na     // source candle of the armed level = where its line starts

// Returns true on the bar the level is filled.
// The state machine runs whether or not the timeframe is displayed, so toggling one
// back on restores the correct live level instead of waiting for the next close.
// `off` is this timeframe's own step on the staircase, in bars past the live candle.
// `shade` is this row's switch from the Shade group -- the shade colour is not passed
// in, it is resolved in here from `col` and `isBull`, which the row already supplies.
draw(Lvl s, float cand, bool changed, bool isBull, bool active, string tag, color col, string ls, int off, bool shade) =>
    filled = false

    // New HTF candle -> candle 1 of the pattern is now the one that just closed,
    // and it started back at whatever bar the outgoing HTF candle opened on
    if changed and not na(cand)
        s.b1   := s.b0
        s.b0   := bar_index
        s.cand := cand
        s.used := false

    // Arm on displacement: price TRADES beyond the distal edge, leaving it behind.
    // High/low rather than close, on purpose. The running extreme of the forming HTF
    // candle is the same number whether you aggregate it out of 1m bars or read it
    // straight off the native chart, so the level comes out identical on every chart
    // timeframe. Judging it on the chart's close instead would let a 1m close count
    // as a 30m displacement -- that is what made the 30m level jump between charts.
    // `used` is the once-per-HTF-candle latch, so this fires on the first bar that
    // breaks through and the running extreme needs no separate bookkeeping.
    //
    // The break has to CLEAR the contact band, not just the edge. Same threshold the
    // death test below uses, so the two meet exactly: above it the level is live,
    // inside it the level is gone. Without this a level would arm and die on the same
    // tick whenever price stalled inside its own tolerance.
    armed = false
    if not na(s.cand) and not s.used and (isBull ? high > s.cand + tolPts : low < s.cand - tolPts)
        s.lvl  := s.cand
        s.anch := s.b1
        s.used := true
        armed  := true

    // Death. The invariant this enforces, at every tick: a BEAR level is only on the
    // chart while price is BELOW it, a BULL level only while price is ABOVE it. Price
    // on the wrong side means the edge has been traded through -- it has been tested,
    // so there is no imbalance left to mark and the line goes.
    //
    // "Back on the wrong side" means inside the contact band, not strictly through the
    // edge -- price getting within tolerance of a level counts as reaching it.
    //
    // Three cases. The chart bar that ARMED the level is always special: it opened on
    // the wrong side of the level and traded through, so its own low/high is from
    // BEFORE the break and would kill the level on the tick after it armed. It is
    // judged on the close instead -- breaking out and closing back inside on the very
    // same bar is a failed displacement, so the level disarms, can arm again if price
    // pushes back out, and raises no fill alert.
    //
    // Once the HTF candle that armed the level has closed, the level is real: the
    // first TRADE back to it sweeps it for good, wick included, and that is what the
    // alert fires on.
    //
    // In between -- level armed, its HTF candle still forming -- is what `tfKill`
    // switches. Off: keep waiting for a chart close back inside, treated as a failed
    // displacement. On: fall straight through to the wick test, so a 1m touch kills
    // the 15m level without waiting for the 15m close. That is the stricter and more
    // faithful reading of the method: the 15m gap only survives if the 15m candle's
    // own low stays clear of the level, so any touch has already closed it. `used`
    // stays latched on that path, so the level cannot re-arm inside an HTF candle
    // whose own wick has already filled the gap.
    if not na(s.lvl)
        if armed
            if (isBull ? close <= s.lvl + tolPts : close >= s.lvl - tolPts)
                s.lvl  := na
                s.used := false
        else if s.used and not tfKill
            if (isBull ? close <= s.lvl + tolPts : close >= s.lvl - tolPts)
                s.lvl  := na
                s.used := false
        else if (isBull ? low <= s.lvl + tolPts : high >= s.lvl - tolPts)
            filled := true
            s.lvl  := na

    // Render
    if not active or na(s.lvl)
        line.delete(s.ln)
        label.delete(s.lb)
        box.delete(s.sh)
        s.ln := na
        s.lb := na
        s.sh := na
    else
        // Default: the line lives in the empty space to the RIGHT of the live candle,
        // running out to its label. The other modes run back over the candles instead.
        int xA   = bar_index
        int xB   = bar_index + math.max(1, off)
        if lineSpan != "Right of price"
            // Start at the source candle, clamped to bar_index's reach and kept a bar
            // back from price so the line is never zero-length or inverted.
            int a  = na(s.anch) ? bar_index - 1 : s.anch
            int lo = math.max(0, bar_index - MAXBACK)
            int hi = math.max(0, bar_index - 1)
            xA := a < lo ? lo : a > hi ? hi : a
            xB := bar_index
        int xLbl = bar_index + off + 1
        if na(s.ln) or armed
            line.delete(s.ln)
            label.delete(s.lb)
            // force_overlay welds the drawings to the price pane. Without it TradingView
            // is free to hand the script its own pane, and a pane with no candles in it
            // autoscales to the levels themselves -- they stop tracking price entirely.
            s.ln := line.new(xA, s.lvl, xB, s.lvl, extend = extLeft ? extend.left : extend.none, color = col, width = lnWidth, style = ls, force_overlay = true)
            s.lb := showLbls ? label.new(xLbl, s.lvl, tag, style = label.style_none, textcolor = lblMode == "Custom" ? lblCustom : col, size = lblSz, force_overlay = true) : na
        else
            // both ends walk with price; the clamp keeps x1 inside bar_index's reach
            line.set_x1(s.ln, xA)
            line.set_x2(s.ln, xB)
            if not na(s.lb)
                label.set_x(s.lb, xLbl)

        // ── Shade ─────────────────────────────────────────────────────────────
        // The band between price and the level. Its x run is bar_index out to
        // bar_index + off -- the line's own span in "Right of price", off the same
        // `off` the line and label use, so widening Offset right or the staircase
        // step lengthens the shade with them. It is pinned right of price whatever
        // `lineSpan` says: switching the line to run back over the candles moves the
        // line only and leaves the shade where it is.
        //
        // Top and bottom come out of max/min rather than off `isBull`. The direction
        // is already implied -- a bull level is only ever on the chart while price is
        // ABOVE it, a bear level only while price is below -- so this is the right way
        // up by construction, and it stays the right way up on the armed bar, where
        // price has only just crossed and the invariant is one tick old.
        //
        // Updated in place rather than recreated: unlike the line it has no style that
        // depends on the level, so there is nothing to rebuild when the level re-arms.
        if shade and shdOn
            int   xR  = bar_index + math.max(1, off)
            float yHi = math.max(close, s.lvl)
            float yLo = math.min(close, s.lvl)
            if na(s.sh)
                s.sh := box.new(bar_index, yHi, xR, yLo
                  , border_color = shdBd ? col : na
                  , border_width = shdBd ? shdBdW : 0
                  , border_style = sty(shdBdSt)
                  , bgcolor      = shade_css(isBull, col)
                  , force_overlay = true)
            else
                box.set_lefttop(s.sh, bar_index, yHi)
                box.set_rightbottom(s.sh, xR, yLo)
        else if not na(s.sh)
            // Row's shade switched off under a live level -- drop the box but leave
            // the level alone, it is still a level.
            box.delete(s.sh)
            s.sh := na

    // Gated by `active`: a row that is off is fed the chart's own timeframe by req()
    // rather than its real one, so its state machine is running on data that means
    // nothing. It draws nothing either way -- this keeps it out of the alerts too.
    filled and active

var Lvl uT10S = Lvl.new(), var Lvl dT10S = Lvl.new()
var Lvl uT15S = Lvl.new(), var Lvl dT15S = Lvl.new()
var Lvl uT30S = Lvl.new(), var Lvl dT30S = Lvl.new()
var Lvl uT1   = Lvl.new(), var Lvl dT1   = Lvl.new()
var Lvl uT2   = Lvl.new(), var Lvl dT2   = Lvl.new()
var Lvl uT3   = Lvl.new(), var Lvl dT3   = Lvl.new()
var Lvl uT4   = Lvl.new(), var Lvl dT4   = Lvl.new()
var Lvl uT5   = Lvl.new(), var Lvl dT5   = Lvl.new()
var Lvl uT6   = Lvl.new(), var Lvl dT6   = Lvl.new()
var Lvl uT10  = Lvl.new(), var Lvl dT10  = Lvl.new()
var Lvl uT12  = Lvl.new(), var Lvl dT12  = Lvl.new()
var Lvl uT15  = Lvl.new(), var Lvl dT15  = Lvl.new()
var Lvl uT20  = Lvl.new(), var Lvl dT20  = Lvl.new()
var Lvl uT30  = Lvl.new(), var Lvl dT30  = Lvl.new()
var Lvl uT45  = Lvl.new(), var Lvl dT45  = Lvl.new()
var Lvl uT60  = Lvl.new(), var Lvl dT60  = Lvl.new()
var Lvl uT120 = Lvl.new(), var Lvl dT120 = Lvl.new()
var Lvl uT180 = Lvl.new(), var Lvl dT180 = Lvl.new()
var Lvl uT240 = Lvl.new(), var Lvl dT240 = Lvl.new()
var Lvl uT360 = Lvl.new(), var Lvl dT360 = Lvl.new()
var Lvl uT480 = Lvl.new(), var Lvl dT480 = Lvl.new()
var Lvl uT720 = Lvl.new(), var Lvl dT720 = Lvl.new()
var Lvl uTD   = Lvl.new(), var Lvl dTD   = Lvl.new()
var Lvl uTW   = Lvl.new(), var Lvl dTW   = Lvl.new()
var Lvl uTM   = Lvl.new(), var Lvl dTM   = Lvl.new()

// ─── Which rows are live ──────────────────────────────────────────────────────
// Computed BEFORE the data requests, because the requests below use it: a row that
// is off, or hidden for sitting under the chart timeframe, asks for the chart's own
// timeframe instead of its real one. Its state machine then runs on chart data and
// draws nothing, which costs no memory, where requesting 10s bars across a year of
// history costs a great deal. Toggling a row forces a full recalculation, so the
// substituted rows can never be seen.
chartSec = timeframe.in_seconds()
aT10S = eT10S and (not hideLower or timeframe.in_seconds("10S") >= chartSec)
aT15S = eT15S and (not hideLower or timeframe.in_seconds("15S") >= chartSec)
aT30S = eT30S and (not hideLower or timeframe.in_seconds("30S") >= chartSec)
aT1   = eT1   and (not hideLower or timeframe.in_seconds("1")   >= chartSec)
aT2   = eT2   and (not hideLower or timeframe.in_seconds("2")   >= chartSec)
aT3   = eT3   and (not hideLower or timeframe.in_seconds("3")   >= chartSec)
aT4   = eT4   and (not hideLower or timeframe.in_seconds("4")   >= chartSec)
aT5   = eT5   and (not hideLower or timeframe.in_seconds("5")   >= chartSec)
aT6   = eT6   and (not hideLower or timeframe.in_seconds("6")   >= chartSec)
aT10  = eT10  and (not hideLower or timeframe.in_seconds("10")  >= chartSec)
aT12  = eT12  and (not hideLower or timeframe.in_seconds("12")  >= chartSec)
aT15  = eT15  and (not hideLower or timeframe.in_seconds("15")  >= chartSec)
aT20  = eT20  and (not hideLower or timeframe.in_seconds("20")  >= chartSec)
aT30  = eT30  and (not hideLower or timeframe.in_seconds("30")  >= chartSec)
aT45  = eT45  and (not hideLower or timeframe.in_seconds("45")  >= chartSec)
aT60  = eT60  and (not hideLower or timeframe.in_seconds("60")  >= chartSec)
aT120 = eT120 and (not hideLower or timeframe.in_seconds("120") >= chartSec)
aT180 = eT180 and (not hideLower or timeframe.in_seconds("180") >= chartSec)
aT240 = eT240 and (not hideLower or timeframe.in_seconds("240") >= chartSec)
aT360 = eT360 and (not hideLower or timeframe.in_seconds("360") >= chartSec)
aT480 = eT480 and (not hideLower or timeframe.in_seconds("480") >= chartSec)
aT720 = eT720 and (not hideLower or timeframe.in_seconds("720") >= chartSec)
aTD   = eTD   and (not hideLower or timeframe.in_seconds("D")   >= chartSec)
aTW   = eTW   and (not hideLower or timeframe.in_seconds("W")   >= chartSec)
aTM   = eTM   and (not hideLower or timeframe.in_seconds("M")   >= chartSec)

// Real timeframe when the row is live, chart timeframe when it is not.
req(string tf, bool on) => on ? tf : timeframe.period

// ─── Higher timeframe data (non-repainting: prior closed candle only) ─────────
// lookahead_on + the [1] offset is the pair that makes this timeframe-agnostic.
// [1] is always a CLOSED candle, so nothing leaks; lookahead_on is what stops the
// value from depending on the chart you happen to be looking at. With lookahead_off
// a historical chart bar is handed the candle BEFORE the one the native chart sees
// -- so the same 30m level read one candle back on a 1m chart and repainted forward
// by one candle the moment a bar went from realtime to historical.
[pT10Sh, pT10Sl, pT10St] = request.security(syminfo.tickerid, req("10S", aT10S), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT15Sh, pT15Sl, pT15St] = request.security(syminfo.tickerid, req("15S", aT15S), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT30Sh, pT30Sl, pT30St] = request.security(syminfo.tickerid, req("30S", aT30S), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT1h,   pT1l,   pT1t  ] = request.security(syminfo.tickerid, req("1", aT1),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT2h,   pT2l,   pT2t  ] = request.security(syminfo.tickerid, req("2", aT2),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT3h,   pT3l,   pT3t  ] = request.security(syminfo.tickerid, req("3", aT3),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT4h,   pT4l,   pT4t  ] = request.security(syminfo.tickerid, req("4", aT4),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT5h,   pT5l,   pT5t  ] = request.security(syminfo.tickerid, req("5", aT5),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT6h,   pT6l,   pT6t  ] = request.security(syminfo.tickerid, req("6", aT6),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT10h,  pT10l,  pT10t ] = request.security(syminfo.tickerid, req("10", aT10),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT12h,  pT12l,  pT12t ] = request.security(syminfo.tickerid, req("12", aT12),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT15h,  pT15l,  pT15t ] = request.security(syminfo.tickerid, req("15", aT15),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT20h,  pT20l,  pT20t ] = request.security(syminfo.tickerid, req("20", aT20),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT30h,  pT30l,  pT30t ] = request.security(syminfo.tickerid, req("30", aT30),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT45h,  pT45l,  pT45t ] = request.security(syminfo.tickerid, req("45", aT45),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT60h,  pT60l,  pT60t ] = request.security(syminfo.tickerid, req("60", aT60),  [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT120h, pT120l, pT120t] = request.security(syminfo.tickerid, req("120", aT120), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT180h, pT180l, pT180t] = request.security(syminfo.tickerid, req("180", aT180), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT240h, pT240l, pT240t] = request.security(syminfo.tickerid, req("240", aT240), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT360h, pT360l, pT360t] = request.security(syminfo.tickerid, req("360", aT360), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT480h, pT480l, pT480t] = request.security(syminfo.tickerid, req("480", aT480), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pT720h, pT720l, pT720t] = request.security(syminfo.tickerid, req("720", aT720), [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pTDh,   pTDl,   pTDt  ] = request.security(syminfo.tickerid, req("D", aTD),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pTWh,   pTWl,   pTWt  ] = request.security(syminfo.tickerid, req("W", aTW),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pTMh,   pTMl,   pTMt  ] = request.security(syminfo.tickerid, req("M", aTM),   [high[1], low[1], time], lookahead = barmerge.lookahead_on)

cT10S = not na(pT10St) and (na(pT10St[1]) or pT10St != pT10St[1])
cT15S = not na(pT15St) and (na(pT15St[1]) or pT15St != pT15St[1])
cT30S = not na(pT30St) and (na(pT30St[1]) or pT30St != pT30St[1])
cT1   = not na(pT1t)   and (na(pT1t[1])   or pT1t   != pT1t[1])
cT2   = not na(pT2t)   and (na(pT2t[1])   or pT2t   != pT2t[1])
cT3   = not na(pT3t)   and (na(pT3t[1])   or pT3t   != pT3t[1])
cT4   = not na(pT4t)   and (na(pT4t[1])   or pT4t   != pT4t[1])
cT5   = not na(pT5t)   and (na(pT5t[1])   or pT5t   != pT5t[1])
cT6   = not na(pT6t)   and (na(pT6t[1])   or pT6t   != pT6t[1])
cT10  = not na(pT10t)  and (na(pT10t[1])  or pT10t  != pT10t[1])
cT12  = not na(pT12t)  and (na(pT12t[1])  or pT12t  != pT12t[1])
cT15  = not na(pT15t)  and (na(pT15t[1])  or pT15t  != pT15t[1])
cT20  = not na(pT20t)  and (na(pT20t[1])  or pT20t  != pT20t[1])
cT30  = not na(pT30t)  and (na(pT30t[1])  or pT30t  != pT30t[1])
cT45  = not na(pT45t)  and (na(pT45t[1])  or pT45t  != pT45t[1])
cT60  = not na(pT60t)  and (na(pT60t[1])  or pT60t  != pT60t[1])
cT120 = not na(pT120t) and (na(pT120t[1]) or pT120t != pT120t[1])
cT180 = not na(pT180t) and (na(pT180t[1]) or pT180t != pT180t[1])
cT240 = not na(pT240t) and (na(pT240t[1]) or pT240t != pT240t[1])
cT360 = not na(pT360t) and (na(pT360t[1]) or pT360t != pT360t[1])
cT480 = not na(pT480t) and (na(pT480t[1]) or pT480t != pT480t[1])
cT720 = not na(pT720t) and (na(pT720t[1]) or pT720t != pT720t[1])
cTD   = not na(pTDt)   and (na(pTDt[1])   or pTDt   != pTDt[1])
cTW   = not na(pTWt)   and (na(pTWt[1])   or pTWt   != pTWt[1])
cTM   = not na(pTMt)   and (na(pTMt[1])   or pTMt   != pTMt[1])


// ─── Staircase ────────────────────────────────────────────────────────────────
// Each timeframe's rank = how many ACTIVE timeframes sit below it, so the ladder
// closes up automatically when a row is switched off or hidden by "Hide timeframes
// below chart TF". Rank 0 gets exactly "Offset right"; every step adds stairStep.
rT10S = 0
rT15S = rT10S + (aT10S ? 1 : 0)
rT30S = rT15S + (aT15S ? 1 : 0)
rT1   = rT30S + (aT30S ? 1 : 0)
rT2   = rT1   + (aT1   ? 1 : 0)
rT3   = rT2   + (aT2   ? 1 : 0)
rT4   = rT3   + (aT3   ? 1 : 0)
rT5   = rT4   + (aT4   ? 1 : 0)
rT6   = rT5   + (aT5   ? 1 : 0)
rT10  = rT6   + (aT6   ? 1 : 0)
rT12  = rT10  + (aT10  ? 1 : 0)
rT15  = rT12  + (aT12  ? 1 : 0)
rT20  = rT15  + (aT15  ? 1 : 0)
rT30  = rT20  + (aT20  ? 1 : 0)
rT45  = rT30  + (aT30  ? 1 : 0)
rT60  = rT45  + (aT45  ? 1 : 0)
rT120 = rT60  + (aT60  ? 1 : 0)
rT180 = rT120 + (aT120 ? 1 : 0)
rT240 = rT180 + (aT180 ? 1 : 0)
rT360 = rT240 + (aT240 ? 1 : 0)
rT480 = rT360 + (aT360 ? 1 : 0)
rT720 = rT480 + (aT480 ? 1 : 0)
rTD   = rT720 + (aT720 ? 1 : 0)
rTW   = rTD   + (aTD   ? 1 : 0)
rTM   = rTW   + (aTW   ? 1 : 0)

stepOf(int rank) => lblOffset + (stairOn ? rank * stairStep : 0)

// ─── Draw ─────────────────────────────────────────────────────────────────────
fuT10S = draw(uT10S, pT10Sh, cT10S, true,  aT10S, "10s", hT10S, sty(sT10S), stepOf(rT10S), zT10S)
fdT10S = draw(dT10S, pT10Sl, cT10S, false, aT10S, "10s", lT10S, sty(sT10S), stepOf(rT10S), zT10S)
fuT15S = draw(uT15S, pT15Sh, cT15S, true,  aT15S, "15s", hT15S, sty(sT15S), stepOf(rT15S), zT15S)
fdT15S = draw(dT15S, pT15Sl, cT15S, false, aT15S, "15s", lT15S, sty(sT15S), stepOf(rT15S), zT15S)
fuT30S = draw(uT30S, pT30Sh, cT30S, true,  aT30S, "30s", hT30S, sty(sT30S), stepOf(rT30S), zT30S)
fdT30S = draw(dT30S, pT30Sl, cT30S, false, aT30S, "30s", lT30S, sty(sT30S), stepOf(rT30S), zT30S)
fuT1   = draw(uT1,   pT1h,   cT1,   true,  aT1,   "1m",  hT1,   sty(sT1),   stepOf(rT1), zT1)
fdT1   = draw(dT1,   pT1l,   cT1,   false, aT1,   "1m",  lT1,   sty(sT1),   stepOf(rT1), zT1)
fuT2   = draw(uT2,   pT2h,   cT2,   true,  aT2,   "2m",  hT2,   sty(sT2),   stepOf(rT2), zT2)
fdT2   = draw(dT2,   pT2l,   cT2,   false, aT2,   "2m",  lT2,   sty(sT2),   stepOf(rT2), zT2)
fuT3   = draw(uT3,   pT3h,   cT3,   true,  aT3,   "3m",  hT3,   sty(sT3),   stepOf(rT3), zT3)
fdT3   = draw(dT3,   pT3l,   cT3,   false, aT3,   "3m",  lT3,   sty(sT3),   stepOf(rT3), zT3)
fuT4   = draw(uT4,   pT4h,   cT4,   true,  aT4,   "4m",  hT4,   sty(sT4),   stepOf(rT4), zT4)
fdT4   = draw(dT4,   pT4l,   cT4,   false, aT4,   "4m",  lT4,   sty(sT4),   stepOf(rT4), zT4)
fuT5   = draw(uT5,   pT5h,   cT5,   true,  aT5,   "5m",  hT5,   sty(sT5),   stepOf(rT5), zT5)
fdT5   = draw(dT5,   pT5l,   cT5,   false, aT5,   "5m",  lT5,   sty(sT5),   stepOf(rT5), zT5)
