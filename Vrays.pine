 //@version=6
// Vrays — multi-timeframe imbalance distal edges (the Vequilibrium method)
//
// Marks the FAR edge of an imbalance on every higher timeframe: candle 1's high on
// a bullish displacement, candle 1's low on a bearish one — candle 1 being the
// candle that just closed. It does not wait for the 3-candle pattern to complete;
// the moment the forming candle trades beyond candle 1's extreme the imbalance is
// being created and that extreme tick is the distal edge. Arms on displacement,
// dies the moment price is back on the wrong side of it. Both halves run on traded
// price, not closes, so the levels are identical on every chart timeframe -- unless
// "Sweep on chart-TF touch" is on, which trades that guarantee for killing levels
// the instant the chart you are on touches them.
//
// Each level can also carry a SHADE: the band between price and the level, filling the
// empty space to the right of the live candle for exactly as many bars as that level's
// own line runs. Per-timeframe on/off in its own group, so you can draw every ray and
// shade only the handful you are trading off.
//
// Split out of Vexcision, which carried this and the Fair Value Gap module in one
// script. Each half asks its own timeframes for data and the pair of them together
// ran the script out of memory, so they are separate indicators now. The other
// half is VfvgX. Add both if you want both.

indicator("Vrays", "Vrays", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─── Contact ──────────────────────────────────────────────────────────────────
gC = "Contact"
tolPts = input.float(1, "Contact tolerance (points)", minval = 0, step = 0.25, group = gC, tooltip = "Price coming within this many points of a level counts as reaching it — the level is swept, same as a clean touch. It also raises the bar for displacement: a move only counts as leaving the level behind once it clears the band, so a level can never appear already inside its own contact zone. 0 = exact touches only (MNQ: 1 point = 4 ticks).", display = display.none)
tfKill = input.bool(false, "Sweep on chart-TF touch", group = gC, tooltip = "Off: while the higher-timeframe candle that armed a level is still forming, the level only dies when the CHART CLOSES back inside it — on a 15m chart that means waiting for the 15m close. On: the first chart-timeframe WICK back into it sweeps it, so the 15m level dies the moment a 1m bar touches it with the 15m candle still open. The reasoning: for the 15m gap to survive, the 15m candle's own low has to stay above the level, so a 1m touch has already closed it. The bar that armed the level is exempt either way — it straddles the level by construction. Trade-off: a lower chart timeframe can see the intrabar sequence and will kill levels a higher chart cannot yet rule out, so with this on the levels are no longer identical on every chart timeframe. These kills also raise the fill alert, where the close-based disarm does not.", display = display.none)

// ─── Display ──────────────────────────────────────────────────────────────────
gD = "Vequilibrium · Display"
hideLower = input.bool(true, "Hide timeframes below chart TF", group = gD, tooltip = "On a 15m chart, skip the 5m / 10m levels.", display = display.none)
showLbls  = input.bool(true, "Show timeframe labels",          group = gD, display = display.none)
lblMode   = input.string("Match line", "Label colour", options = ["Match line", "Custom"], group = gD, display = display.none)
lblCustom = input.color (#d1d4dc, "Custom label colour", group = gD, display = display.none)
lblOffset = input.int (4, "Offset right (bars)", minval = 0, maxval = 50, group = gD, tooltip = "Minimum distance past the live candle. With the staircase on this is what the LOWEST active timeframe gets; everything above it steps further right.", display = display.none)
stairOn   = input.bool(true, "Staircase by timeframe", group = gD, inline = "stair", display = display.none)
stairStep = input.int (2, "", minval = 1, maxval = 20, group = gD, inline = "stair", tooltip = "Fans the levels out instead of stacking them at one x. The lowest ACTIVE timeframe sits at 'Offset right', the next active one steps this many bars further right, and so on. Only enabled (and un-hidden) timeframes take a step, so the ladder tightens up as you switch timeframes off.", display = display.none)
lblSize   = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = gD, display = display.none)
lnWidth   = input.int (1, "Line width", minval = 1, maxval = 4, group = gD, display = display.none)
lineSpan  = input.string("Right of price", "Line placement", options = ["Right of price", "From source candle"], group = gD, tooltip = "Right of price: the line sits in the empty space between the live candle and its label. From source candle: it runs back over the candles to the high/low that created it.", display = display.none)
extLeft   = input.bool(false, "Extend lines left", group = gD, tooltip = "Adds a ray running from the line's left end to the edge of the chart. Combines with either placement.", display = display.none)

lblSz = lblSize == "Tiny" ? size.tiny : lblSize == "Normal" ? size.normal : lblSize == "Large" ? size.large : size.small

// bar_index coordinates only reach ~500 bars back, and a 1W source candle sits much
// further than that on a 1m chart. Anchors are clamped to this instead of failing.
MAXBACK = 480

// ─── Shade ────────────────────────────────────────────────────────────────────
// The band between price and a level, filling the empty space to the right of the live
// candle. It answers "how far is price from this ray" without reading the scale, and
// because the near edge is `close` every bar it breathes as price moves -- the mirror
// of VfvgX's boxes eroding as price fills them, except there is nothing to eat into
// here, only the distance left to travel.
//
// Its length is deliberately NOT its own setting: it comes off the same per-timeframe
// step the line and label already use, so Offset right and the staircase move all
// three together and there is nothing to keep in sync by hand.
gS = "Vequilibrium · Shade"
shdOn    = input.bool(true, "Show shade", group = gS, tooltip = "Fills the gap between price and each level, right of the live candle, running exactly as long as that level's own line. Which timeframes get one is the grid below. Several at once overlap by design — they all start at price and fan out with the staircase — so switch rows off rather than reaching for the transparency when it gets busy.", display = display.none)
shdSrc   = input.string("Line colour", "Shade colour", options = ["Line colour", "Custom"], group = gS, tooltip = "Line colour = the row's own colour from the Timeframes group, so a 4h shade matches the 4h ray and you can still tell them apart when several overlap. Custom = the one pair below for every row.", display = display.none)
shdBull  = input.color(#b31217, "Custom shade — bull / bear", inline = 'sc', group = gS, display = display.none)
shdBear  = input.color(#12b34d, "", inline = 'sc', group = gS, tooltip = "Only used when the colour mode above is Custom. Bull = the level left behind by an upward displacement (candle 1's high), bear = candle 1's low — the same pairing, and the same default hues, as the Timeframes rows.", display = display.none)
shdTrans = input.int(88, "Shade transparency", minval = 0, maxval = 100, group = gS, tooltip = "0 = solid, 100 = invisible. Stamped over whatever the colour mode resolves to, so it REPLACES any transparency already carried by the line colour — this is the one place the shade's opacity is decided.", display = display.none)
shdBd    = input.bool(false, "Shade border", inline = 'sb', group = gS, display = display.none)
shdBdW   = input.int(1, "", minval = 1, maxval = 4, inline = 'sb', group = gS, display = display.none)
shdBdSt  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = 'sb', group = gS, tooltip = "Outlines the shade in the row's own line colour, at full opacity rather than the fill's. Enable · thickness · style.", display = display.none)

// Per-timeframe shade switches, kept apart from the line switches so you can run every
// ray and shade only the two or three you are actually trading off. A row whose LINE is
// off is never shaded whatever this says -- the shade needs a live level to measure to.
// Defaults mirror the line defaults in the Timeframes group below, so switching the
// feature on shades what the script was already drawing rather than nothing.
SSTIP = "Which timeframes get a shade. Independent of the enable switches in the Timeframes group: a timeframe needs its line on to have a level at all, and needs this to have that level shaded."

zT10S = input.bool(true,  "10s", inline = 'z1', group = gS, display = display.none)
zT15S = input.bool(true,  "15s", inline = 'z1', group = gS, display = display.none)
zT30S = input.bool(true,  "30s", inline = 'z1', group = gS, display = display.none)
zT1   = input.bool(true,  "1m",  inline = 'z1', group = gS, display = display.none)
zT2   = input.bool(false, "2m",  inline = 'z1', group = gS, tooltip = SSTIP, display = display.none)

zT3   = input.bool(false, "3m",  inline = 'z2', group = gS, display = display.none)
zT4   = input.bool(false, "4m",  inline = 'z2', group = gS, display = display.none)
zT5   = input.bool(true,  "5m",  inline = 'z2', group = gS, display = display.none)
zT6   = input.bool(false, "6m",  inline = 'z2', group = gS, display = display.none)
zT10  = input.bool(true,  "10m", inline = 'z2', group = gS, tooltip = SSTIP, display = display.none)

zT12  = input.bool(false, "12m", inline = 'z3', group = gS, display = display.none)
zT15  = input.bool(true,  "15m", inline = 'z3', group = gS, display = display.none)
zT20  = input.bool(false, "20m", inline = 'z3', group = gS, display = display.none)
zT30  = input.bool(true,  "30m", inline = 'z3', group = gS, display = display.none)
zT45  = input.bool(false, "45m", inline = 'z3', group = gS, tooltip = SSTIP, display = display.none)

zT60  = input.bool(true,  "1h",  inline = 'z4', group = gS, display = display.none)
zT120 = input.bool(true,  "2h",  inline = 'z4', group = gS, display = display.none)
zT180 = input.bool(false, "3h",  inline = 'z4', group = gS, display = display.none)
zT240 = input.bool(true,  "4h",  inline = 'z4', group = gS, display = display.none)
zT360 = input.bool(false, "6h",  inline = 'z4', group = gS, tooltip = SSTIP, display = display.none)

zT480 = input.bool(false, "8h",  inline = 'z5', group = gS, display = display.none)
zT720 = input.bool(false, "12h", inline = 'z5', group = gS, display = display.none)
zTD   = input.bool(true,  "1D",  inline = 'z5', group = gS, display = display.none)
zTW   = input.bool(true,  "1W",  inline = 'z5', group = gS, display = display.none)
zTM   = input.bool(false, "1M",  inline = 'z5', group = gS, tooltip = SSTIP, display = display.none)

// ─── Timeframes ───────────────────────────────────────────────────────────────
// Per row: on/off · bull colour (candle 1's high) · bear colour (candle 1's low) · style
gT  = "Vequilibrium · Timeframes"
TIP = "Enable · bull colour · bear colour · line style"

eT10S = input.bool  (true,  "10s", group = gT, inline = "r10S", display = display.none)
hT10S = input.color (#790c10, "",  group = gT, inline = "r10S", display = display.none)
lT10S = input.color (#0c7934, "",  group = gT, inline = "r10S", display = display.none)
sT10S = input.string("Solid", "",  group = gT, inline = "r10S", options = ["Solid", "Dashed", "Dotted"], tooltip = TIP, display = display.none)

eT15S = input.bool  (true,  "15s", group = gT, inline = "r15S", display = display.none)
